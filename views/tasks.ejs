<%- include('partials/header') %>

<header class="dashboard-header">
    <h1>Welcome, <%= username %></h1>
    <a href="/auth/logout" class="btn btn-logout">Logout</a>
</header>

<section class="task-input-section">
    <form action="/tasks" method="POST" class="add-task-form" id="addTaskForm">
        <input type="text" name="title" class="main-task-input" placeholder="What needs to be done?" required autocomplete="off">
        <div class="task-form-controls">
            <!-- Visible picker: does NOT get submitted (no name attribute) -->
            <input type="datetime-local" id="dueDateLocal" class="date-picker-input">
            <!-- Hidden field that actually gets submitted as UTC ISO string -->
            <input type="hidden" name="dueDate" id="dueDateUTC">
            <button type="submit" class="btn btn-primary">Add Task</button>
        </div>
    </form>
</section>

<nav class="task-filters">
    <a href="/tasks" class="<%= currentFilter === 'all' ? 'active' : '' %>">All</a>
    <a href="/tasks?status=pending" class="<%= currentFilter === 'pending' ? 'active' : '' %>">Pending</a>
    <a href="/tasks?status=completed" class="<%= currentFilter === 'completed' ? 'active' : '' %>">Completed</a>
</nav>

<section class="task-list-section">
    <% if (tasks.length === 0) { %>
        <p class="empty-state">No tasks found.</p>
    <% } else { %>
        <ul class="task-list">
            <% tasks.forEach(task => { %>
                <li class="task-item <%= task.status === 'completed' ? 'completed-task' : (task.status === 'overdue' ? 'overdue-task' : '') %>" style="<%= task.status === 'overdue' ? 'border-left: 4px solid red;' : '' %>">
                    <div style="display: flex; flex-direction: column;">
                        <span class="task-title"><%= task.title %></span>
                        <% if (task.dueDate) { %>
                            <span class="task-due-date" style="font-size: 0.8rem; color: #888;">Due: <%= new Date(task.dueDate).toLocaleString() %></span>
                        <% } %>
                        <% if (task.status === 'overdue') { %>
                            <span style="color: red; font-size: 0.8rem; font-weight: bold;">[OVERDUE]</span>
                        <% } %>
                    </div>
                    
                    <div class="task-actions">
                        <% if (task.status === 'pending') { %>
                            <form action="/tasks/<%= task._id %>/status" method="POST">
                                <input type="hidden" name="status" value="completed">
                                <button type="submit" class="btn btn-success">✓</button>
                            </form>
                        <% } %>
                        
                        <form action="/tasks/<%= task._id %>/status" method="POST">
                            <input type="hidden" name="status" value="deleted">
                            <button type="submit" class="btn btn-danger">✗</button>
                        </form>

                        <div class="task-actions">
                            <button onclick="triggerEdit('<%= task._id %>', `<%= task.title %>`)" class="btn btn-edit">✎</button>

                            <form action="/tasks/<%= task._id %>/complete" method="POST">...</form>
                        </div>
                    </div>
                </li>
            <% }) %>
        </ul>
    <% } %>
</section>


<form id="editForm" method="POST" action="" style="display: none;">
    <input type="hidden" name="title" id="editTitleInput">
</form>

<script>
    // ── UTC Timezone Fix for datetime-local picker ────────────────
    // The browser's datetime-local sends time in LOCAL format (no timezone).
    // We intercept the form submit and convert it to a true UTC ISO string
    // before sending to the server, so the cron job compares correctly.
    document.getElementById('addTaskForm').addEventListener('submit', function (e) {
        const localInput = document.getElementById('dueDateLocal');
        const utcInput   = document.getElementById('dueDateUTC');

        if (localInput.value) {
            // new Date() in the BROWSER interprets datetime-local as LOCAL time
            const localDate = new Date(localInput.value);
            utcInput.value  = localDate.toISOString(); // e.g. "2026-07-06T20:13:00.000Z"
        }
        // If no date was picked, leave utcInput empty → server treats it as no dueDate
    });

    // ── Edit Task ─────────────────────────────────────────────────
    function triggerEdit(taskId, currentTitle) {
        const updatedTitle = prompt("Edit your task:", currentTitle);
        if (updatedTitle && updatedTitle.trim() !== "" && updatedTitle !== currentTitle) {
            const form  = document.getElementById('editForm');
            const input = document.getElementById('editTitleInput');
            form.action  = `/tasks/${taskId}/edit`;
            input.value  = updatedTitle;
            form.submit();
        }
    }
</script>

<!-- Toast Notification Styles -->
<style>
    #toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .toast {
        min-width: 280px;
        max-width: 360px;
        padding: 14px 18px;
        border-radius: 10px;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 500;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        display: flex;
        align-items: flex-start;
        gap: 10px;
        animation: slideIn 0.3s ease;
        cursor: pointer;
    }
    .toast.success { background: linear-gradient(135deg, #22c55e, #16a34a); }
    .toast.warning { background: linear-gradient(135deg, #f97316, #ea580c); }
    .toast.info    { background: linear-gradient(135deg, #6366f1, #4f46e5); }
    .toast .toast-icon { font-size: 1.2rem; flex-shrink: 0; }
    .toast .toast-body { display: flex; flex-direction: column; gap: 2px; }
    .toast .toast-title { font-weight: 700; font-size: 0.95rem; }
    .toast .toast-msg { font-weight: 400; opacity: 0.9; }
    @keyframes slideIn {
        from { transform: translateX(120%); opacity: 0; }
        to   { transform: translateX(0);   opacity: 1; }
    }
    @keyframes fadeOut {
        from { opacity: 1; transform: translateX(0); }
        to   { opacity: 0; transform: translateX(120%); }
    }
</style>

<div id="toast-container"></div>

<script src="/socket.io/socket.io.js"></script>
<script>
    // ── Toast Helper ──────────────────────────────────────────────
    function showToast(title, message, type = 'info', duration = 5000) {
        const container = document.getElementById('toast-container');
        const icons = { success: '✅', warning: '⚠️', info: 'ℹ️' };

        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        toast.innerHTML = `
            <span class="toast-icon">${icons[type] || 'ℹ️'}</span>
            <div class="toast-body">
                <span class="toast-title">${title}</span>
                <span class="toast-msg">${message}</span>
            </div>
        `;
        toast.onclick = () => removeToast(toast);
        container.appendChild(toast);

        setTimeout(() => removeToast(toast), duration);
    }

    function removeToast(toast) {
        toast.style.animation = 'fadeOut 0.3s ease forwards';
        setTimeout(() => toast.remove(), 300);
    }

    // ── Show toast from URL param (after redirect) ────────────────

    // Add a 'danger' style for deleted tasks
    const style = document.createElement('style');
    style.textContent = `.toast.danger { background: linear-gradient(135deg, #ef4444, #b91c1c); }`;
    document.head.appendChild(style);

    const urlParams = new URLSearchParams(window.location.search);
    const taskTitle  = decodeURIComponent(urlParams.get('task') || 'Your task');

    if (urlParams.get('completed') === '1') {
        showToast('Task Completed! 🎉', `"${taskTitle}" has been marked as done.`, 'success');
        window.history.replaceState({}, '', '/tasks');
    }

    if (urlParams.get('deleted') === '1') {
        showToast('Task Deleted 🗑️', `"${taskTitle}" has been removed.`, 'danger');
        window.history.replaceState({}, '', '/tasks');
    }

    // ── Overdue Toast System (Polling) ────────────────────────────
    // Checks for overdue tasks every 30 seconds in the background.
    // Uses sessionStorage to track which tasks have already been notified
    // so the user only sees each overdue toast once per session.

    function checkForOverdueTasks() {
        fetch('/tasks/overdue-check', {
            headers: { 'Accept': 'application/json' }
        })
        .then(res => {
            if (!res.ok) return null;
            return res.json();
        })
        .then(data => {
            if (!data || !data.overdueTasks) return;

            // Get the list of already-notified task IDs from sessionStorage
            const notified = JSON.parse(sessionStorage.getItem('notifiedOverdue') || '[]');

            data.overdueTasks.forEach(task => {
                if (!notified.includes(task.id)) {
                    showToast('Task Overdue! ⏰', `"${task.title}" is past its due date.`, 'warning', 7000);
                    notified.push(task.id);
                }
            });

            sessionStorage.setItem('notifiedOverdue', JSON.stringify(notified));
            console.log('[Overdue Poller] Checked. Overdue tasks:', data.overdueTasks.length);
        })
        .catch(err => console.warn('[Overdue Poller] Error:', err.message));
    }

    // Run immediately on page load, then every 30 seconds
    checkForOverdueTasks();
    setInterval(checkForOverdueTasks, 30000);

    // ── Socket.io Live Notifications ──────────────────────────────
    const token = "<%= typeof token !== 'undefined' ? token : '' %>";
    if (token) {
        const socket = io({ auth: { token } });

        socket.on('connect', () => {
            console.log('[Socket] Connected:', socket.id);
        });

        socket.on('task_overdue', (data) => {
            console.log('[Socket] task_overdue event received:', data);
            showToast('Task Overdue! ⏰', data.message, 'warning', 7000);
            // Reload after a short delay so user can read the toast
            setTimeout(() => location.reload(), 3000);
        });

        socket.on('task_completed', (data) => {
            console.log('[Socket] task_completed event received:', data);
            showToast('Task Completed! 🎉', data.message, 'success');
        });

        socket.on('connect_error', (err) => {
            console.error('[Socket] Connection error:', err.message);
        });

        socket.on('disconnect', () => {
            console.log('[Socket] Disconnected');
        });
    }
</script>

<%- include('partials/footer') %>